<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="http://schemas.vestigium.dev/converters">
  <DataTemplate x:Key="DomainTab">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <UniformGrid Columns="2">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Id}" Text="CONV-17 PingStatusToColorBrushConverter"/>
            <ComboBox ItemsSource="{Binding PingStatuses}" SelectedItem="{Binding PingStatus}"/>
            <Ellipse Width="22" Height="22" HorizontalAlignment="Left" Fill="{Binding PingStatus, Converter={v:Resolve {x:Type v:PingStatusToColorBrushConverter}}}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Id}" Text="CONV-18 LatencyToSeverityColorConverter"/>
            <Slider Minimum="1" Maximum="250" Value="{Binding LatencyMs}"/>
            <Rectangle Height="14" RadiusX="4" RadiusY="4" Fill="{Binding LatencyMs, Converter={v:Resolve {x:Type v:LatencyToSeverityColorConverter}}}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Id}" Text="CONV-19 HttpStatusCodeToDescriptionConverter"/>
            <Slider Minimum="100" Maximum="599" Value="{Binding HttpStatus}"/>
            <TextBlock FontSize="16" Text="{Binding HttpStatus, Converter={v:Resolve {x:Type v:HttpStatusCodeToDescriptionConverter}}}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Id}" Text="CONV-27 HttpStatusToSeverityBrushConverter"/>
            <Rectangle Height="14" RadiusX="4" RadiusY="4" Fill="{Binding HttpStatus, Converter={v:Resolve {x:Type v:HttpStatusToSeverityBrushConverter}}}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Id}" Text="CONV-20 DnsRecordTypeToIconConverter"/>
            <ComboBox ItemsSource="{Binding DnsTypes}" SelectedItem="{Binding DnsType}"/>
            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="32" Text="{Binding DnsType, Converter={v:Resolve {x:Type v:DnsRecordTypeToIconConverter}}}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Id}" Text="CONV-33 DnsResponseCodeToDescriptionConverter"/>
            <ComboBox ItemsSource="{Binding DnsRcodes}" SelectedItem="{Binding DnsRcode}"/>
            <TextBlock FontSize="16" Text="{Binding DnsRcode, Converter={v:Resolve {x:Type v:DnsResponseCodeToDescriptionConverter}}}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Id}" Text="CONV-34 TraceHopStatusToBrushConverter"/>
            <ComboBox ItemsSource="{Binding TraceHopStatuses}" SelectedItem="{Binding TraceHopStatus}"/>
            <Rectangle Height="14" RadiusX="4" RadiusY="4" Fill="{Binding TraceHopStatus, Converter={v:Resolve {x:Type v:TraceHopStatusToBrushConverter}}}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Id}" Text="CONV-35 PortStateToBrushConverter"/>
            <ComboBox ItemsSource="{Binding PortStates}" SelectedItem="{Binding PortState}"/>
            <Rectangle Height="14" RadiusX="4" RadiusY="4" Fill="{Binding PortState, Converter={v:Resolve {x:Type v:PortStateToBrushConverter}}}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Id}" Text="CONV-38 PacketLossToSeverityBrushConverter"/>
            <Slider Minimum="0" Maximum="20" Value="{Binding PacketLoss}"/>
            <Rectangle Height="14" RadiusX="4" RadiusY="4" Fill="{Binding PacketLoss, Converter={v:Resolve {x:Type v:PacketLossToSeverityBrushConverter}}}"/>
          </StackPanel>
        </Border>
      </UniformGrid>
    </ScrollViewer>
  </DataTemplate>
</ResourceDictionary>
