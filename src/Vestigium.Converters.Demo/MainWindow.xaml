<Window x:Class="Vestigium.Converters.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vestigium.Converters gallery"
        Height="840" Width="1240"
        MinHeight="640" MinWidth="960"
        Background="#0B1A30" Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel LastChildFill="False" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Vestigium.Converters gallery"/>
        <TextBlock Opacity="0.7" Text="AddVestigiumConverters() once. Every sample uses {v:Resolve} — no static converter resources."/>
      </StackPanel>
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Opacity="0.55" Text="42 converters  CONV-01 … CONV-42"/>
    </DockPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Showcase"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource ShowcaseTab}"/></TabItem>
      <TabItem Header="Visibility"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource VisibilityTab}"/></TabItem>
      <TabItem Header="Boolean"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource BooleanTab}"/></TabItem>
      <TabItem Header="Formatting"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource FormattingTab}"/></TabItem>
      <TabItem Header="Numeric"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource NumericTab}"/></TabItem>
      <TabItem Header="Collections"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource CollectionsTab}"/></TabItem>
      <TabItem Header="Domain"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource DomainTab}"/></TabItem>
      <TabItem Header="MultiBinding"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource MultiTab}"/></TabItem>
    </TabControl>
  </Grid>
</Window>
